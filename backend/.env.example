APP_NAME=ShanwaterAdmin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.shanwater.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shanwater
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# 跨域放行的静态站来源（表单提交来源站点的完整 origin，逗号分隔）
CORS_ALLOWED_ORIGINS=https://www.shanwater.com,https://shanwater.com

# 管理后台默认管理员（首次 php artisan migrate --seed 时写入数据库，登录后可改密码）
ADMIN_EMAIL=admin@sum-water.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=管理员

# 表单提交限流：每 IP 每分钟允许的最大提交次数
API_RATE_LIMIT=5
