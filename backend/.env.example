APP_NAME=ShanwaterAdmin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.shanwater.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shanwater
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

CORS_ALLOWED_ORIGINS=https://www.shanwater.com,https://shanwater.com

ADMIN_EMAIL=admin@sum-water.com
ADMIN_PASSWORD=
ADMIN_NAME=admin

API_RATE_LIMIT=5
